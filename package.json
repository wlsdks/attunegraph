{
  "name": "@attunegraph/core",
  "version": "0.1.0",
  "description": "A dependency-free temporal and provenance graph engine for AI agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlsdks/attunegraph.git"
  },
  "bugs": {
    "url": "https://github.com/wlsdks/attunegraph/issues"
  },
  "homepage": "https://github.com/wlsdks/attunegraph#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/architecture/first-principles.md",
    "docs/decisions/agent-native-graph-positioning.md",
    "docs/decisions/first-principles-performance.md",
    "docs/decisions/sqlite-normalized-current-head-index-v3.md",
    "docs/decisions/sqlite-exact-witness-current-head-v4.md",
    "BENCHMARKS.md",
    "PERFORMANCE-QUALIFICATION.md",
    "READINESS.md",
    "CHANGELOG.md",
    "PORTABLE-FORMAT.md",
    "SOURCE-ADAPTERS.md",
    "LICENSE",
    "attunegraph-local-runtime-manifest.json",
    "performance-regression-policy.json",
    "performance-thresholds.json",
    "fixtures/working-graph-v1",
    "scripts/benchmark-attunegraph-agent-decision-read.mjs",
    "scripts/benchmark-attunegraph-prepared-plan-seed.mjs",
    "scripts/benchmark-attunegraph-agent-decision-read-scale.mjs",
    "scripts/benchmark-attunegraph-agent-decision-durable.mjs",
    "scripts/benchmark-attunegraph-agent-decision-mixed-durable.mjs",
    "scripts/benchmark-attunegraph-worker-resource-lifecycle.mjs",
    "scripts/benchmark-attunegraph-sqlite-generation-growth.mjs",
    "scripts/benchmark-attunegraph-current-head-materialization.mjs",
    "scripts/benchmark-attunegraph-v4-storage-cost.mjs",
    "scripts/attunegraph-simulated-v4-witness.mjs",
    "scripts/benchmark-attunegraph-normalized-decision-endpoint.mjs",
    "scripts/qualify-attunegraph-sqlite-compression.mjs",
    "scripts/benchmark-attunegraph-performance.mjs",
    "scripts/benchmark-attunegraph-scale.mjs",
    "scripts/qualify-attunegraph-performance.mjs",
    "scripts/verify-attunegraph-performance-regression.mjs",
    "scripts/readiness-check-contracts.mjs",
    "scripts/readiness-measurement-contracts.mjs",
    "scripts/run-working-graph-readiness.mjs",
    "scripts/verify-working-graph-golden-corpus.mjs",
    "scripts/prepare-attunegraph-runtime.mjs",
    "scripts/direct-entrypoint.mjs",
    "scripts/source-checkout-provenance.mjs",
    "scripts/sqlite-measurement-path.mjs",
    "scripts/capture-attunegraph-readiness.mjs",
    "scripts/capture-attunegraph-measurement.mjs",
    "scripts/score-attunegraph-readiness.mjs"
  ],
  "keywords": [
    "ai-agent",
    "agent-memory",
    "graph",
    "provenance",
    "temporal-graph",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.18.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./backend": {
      "types": "./dist/attunegraph-backend.d.ts",
      "import": "./dist/attunegraph-backend.js"
    },
    "./source-adapter": {
      "types": "./dist/source-adapter.d.ts",
      "import": "./dist/source-adapter.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./readonly-working-graph": {
      "types": "./dist/readonly-working-graph.d.ts",
      "import": "./dist/readonly-working-graph.js"
    },
    "./extension-kit": {
      "types": "./dist/extension-kit.d.ts",
      "import": "./dist/extension-kit.js"
    }
  },
  "scripts": {
    "benchmark:agent-decision-read": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-agent-decision-read.mjs",
    "benchmark:prepared-plan-seed-parts": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-prepared-plan-seed.mjs",
    "benchmark:agent-decision-read-scale": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-agent-decision-read-scale.mjs",
    "benchmark:agent-decision-read-durable": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-agent-decision-durable.mjs",
    "benchmark:agent-decision-mixed-durable": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-agent-decision-mixed-durable.mjs",
    "benchmark:worker-resource-lifecycle": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-worker-resource-lifecycle.mjs",
    "benchmark:sqlite-generation-growth": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-sqlite-generation-growth.mjs",
    "benchmark:current-head-materialization": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-current-head-materialization.mjs",
    "benchmark:v4-storage-cost": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-v4-storage-cost.mjs",
    "benchmark:normalized-decision-endpoint": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-normalized-decision-endpoint.mjs",
    "benchmark:sqlite-compression-qualification": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/qualify-attunegraph-sqlite-compression.mjs",
    "benchmark:scale": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-scale.mjs",
    "benchmark:performance": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/benchmark-attunegraph-performance.mjs",
    "build": "node scripts/prepare-attunegraph-runtime.mjs",
    "check:naming": "node scripts/check-canonical-naming.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "pnpm test:cross-platform",
    "test:benchmark-qualification": "pnpm build && vitest run --config vitest.benchmark-qualification.config.ts",
    "test:cross-platform": "pnpm build && vitest run --config vitest.cross-platform.config.ts --exclude scripts/benchmark-attunegraph-current-head-materialization-fault.test.mjs && vitest run --no-file-parallelism scripts/benchmark-attunegraph-current-head-materialization-fault.test.mjs",
    "test:local-profile": "pnpm build && vitest run --config vitest.local-profile.config.ts",
    "test:performance": "pnpm build && vitest run scripts/benchmark-attunegraph-agent-decision-read.test.mjs scripts/benchmark-attunegraph-agent-decision-read-scale.test.mjs scripts/benchmark-attunegraph-normalized-decision-endpoint.test.mjs scripts/benchmark-attunegraph-prepared-plan-seed.test.mjs scripts/benchmark-attunegraph-performance.test.mjs scripts/qualify-attunegraph-performance.test.mjs scripts/verify-attunegraph-performance-regression.test.mjs",
    "test:readiness": "vitest run --no-file-parallelism scripts/capture-attunegraph-readiness.test.mjs scripts/capture-attunegraph-measurement.test.mjs scripts/readiness-measurement-contracts.test.mjs scripts/score-attunegraph-readiness.test.mjs",
    "test:supported": "pnpm build && vitest run",
    "test:focused": "pnpm build && vitest run src/attunegraph-engine.test.ts src/authority-query.test.ts src/decision-query.test.ts src/attuneql.test.ts src/revocation-impact.test.ts src/revocation-transition.test.ts",
    "example": "pnpm build && node examples/basic-agent.mjs",
    "example:source-adapter": "pnpm build && node examples/source-adapter-agent.mjs",
    "pack:dry-run": "pnpm build && npm pack --dry-run --json",
    "verify:clean-room-consumer": "node scripts/verify-clean-room-consumer.mjs",
    "readiness:capture": "node scripts/capture-attunegraph-readiness.mjs",
    "readiness:capture-measurement": "node scripts/capture-attunegraph-measurement.mjs",
    "verify:working-graph-golden": "node scripts/prepare-attunegraph-runtime.mjs && node scripts/verify-working-graph-golden-corpus.mjs",
    "readiness:score": "node scripts/score-attunegraph-readiness.mjs",
    "performance:qualify": "node scripts/qualify-attunegraph-performance.mjs",
    "performance:regression": "node scripts/verify-attunegraph-performance-regression.mjs",
    "performance:regression:advisory": "node scripts/verify-attunegraph-performance-regression.mjs --gate=advisory",
    "fixtures:portable": "pnpm build && node scripts/generate-attunegraph-portable-fixtures.mjs",
    "verify:local": "pnpm build && node scripts/verify-attunegraph-local.mjs",
    "verify:portable-fixtures": "node scripts/verify-attunegraph-portable-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  }
}
